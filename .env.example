# Database connection string (Required)
# Format: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/mfapis_db

# Logging level (Optional, default: INFO)
LOG_LEVEL=INFO

# FRED API key for economic data (Required for economic pipeline)
# Get free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Alpha Vantage API key (Optional, for future equity/ETF pipelines)
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
